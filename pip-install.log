"""临时测试：验证 WebApiDialog 功能。"""
import os
os.environ["QT_QPA_PLATFORM"] = "offscreen"
import sys
import threading
import time
import json
from http.server import HTTPServer, BaseHTTPRequestHandler

sys.path.insert(0, os.path.dirname(__file__))
from PyQt6.QtWidgets import QApplication
from PyQt6.QtCore import QEventLoop
from PyQt6.QtGui import QFont

from main import QRWindow, WebApiDialog, ApiWorker

app = QApplication(sys.argv)
f = QFont()
f.setPointSize(14)
f.setWeight(QFont.Weight.Bold)
app.setFont(f)

# 1) 菜单
w = QRWindow()
items = [a.text() for a in w.menuBar().actions()]
print("1) menu items:", items)
assert "调用 Web API" in items

# 2) Mock HTTP
received = []


class H(BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(n).decode("utf-8")
        received.append(body)
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(("[ok-echo]" + body).encode())

    def log_message(self, *a, **k):
        pass


srv = HTTPServer(("127.0.0.1", 0), H)
port = srv.server_port
threading.Thread(target=srv.serve_forever, daemon=True).start()
time.sleep(0.1)

# 3) 同步 ApiWorker
worker = ApiWorker("http://127.0.0.1:%d/test" % port, json.dumps({"a": 1}))
got = []
worker.finished.connect(lambda c, b: got.append((c, b)))
worker.failed.connect(lambda m: got.append(("FAIL", m)))
worker.run()
print("2) ApiWorker code:", got[0][0], "| body starts with [ok-echo]:", got[0][1].startswith("[ok-echo]"))
print("   server received:", received[0])

# 4) Dialog
dlg = WebApiDialog()
print("3) dialog title:", dlg.windowTitle(), "| url empty:", dlg._url.text() == "",
      "| body default len:", len(dlg._body.toPlainText()))

# 5) JSON 校验
dlg._body.setPlainText("not valid json")
try:
    json.loads(dlg._body.toPlainText())
    print("FAIL: should have raised")
except json.JSONDecodeError:
    print("4) JSON validation works")

# 6) URL 校验
dlg._url.setText("ftp://x.com")
ok_http = dlg._url.text().startswith("http://") or dlg._url.text().startswith("https://")
print("5) ftp:// rejected:", not ok_http)

# 7) 异步 send
dlg._url.setText("http://127.0.0.1:%d/test" % port)
dlg._body.setPlainText(json.dumps({"hello": "world"}))
dlg._on_send()
# 等异步完成
loop = QEventLoop()
done = []
dlg._worker.finished.connect(lambda c, b: (done.append((c, b)), loop.quit()))
dlg._worker.failed.connect(lambda m: (done.append(("FAIL", m)), loop.quit()))
loop.exec()
print("6) async send result:", done[0])

srv.shutdown()
print("ALL OK")
